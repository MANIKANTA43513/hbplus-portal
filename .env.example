# Public, client-side configuration only. These values are bundled into the app,
# so NEVER put a service-role key, a Google client secret, or any private key here.
#
# Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Both are safe to expose
# because every table is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY
